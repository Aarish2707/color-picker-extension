{
  "manifest_version": 3,
  "name": "PixelPick – Pick Colors from Any Website Instantly",
  "version": "1.0.0",
  "description": "PixelPick is a powerful color picker and eyedropper tool for websites. Capture HEX, RGB, and HSL colors from any webpage instantly.",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
